# Groq API key used by agent/llm_client.py (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your-key-here

# Model used by the agent's reasoning loop (must support Groq tool calling)
PATCHPILOT_MODEL=openai/gpt-oss-120b

# Agent loop / sandbox tuning
MAX_ITERATIONS=6
TEST_TIMEOUT_SECONDS=30
MAX_RUN_DURATION_SECONDS=300

# Directory where per-run sandboxes are created
RUNS_DIR=runs

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend (Vite) -> points at the backend above
VITE_API_BASE_URL=http://localhost:8000
