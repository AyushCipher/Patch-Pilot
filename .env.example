# Anthropic API key used by agent/llm_client.py
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used by the agent's reasoning loop
PATCHPILOT_MODEL=claude-sonnet-4-5-20250929

# Agent loop / sandbox tuning
MAX_ITERATIONS=6
TEST_TIMEOUT_SECONDS=30
MAX_RUN_DURATION_SECONDS=300

# Directory where per-run sandboxes are created
RUNS_DIR=runs

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend (Vite) -> points at the backend above
VITE_API_BASE_URL=http://localhost:8000
